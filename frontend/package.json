{
  "name": "dev-store-app",
  "version": "1.0.0",
  "description": "DevStore",
  "author": {
    "name": "dingjiahui",
    "email": "dingjiahui4@huawei.com"
  },
  "homepage": "https://gitee.com/openeuler/DevStore",
  "private": true,
  "main": "electron/main.js",
  "build": {
    "appId": "your.app.id",
    "productName": "DevStore",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "rpm"
      ],
      "icon": "src/assets/logo.png",
      "category": "Development",
      "executableName": "dev-store-app"
    }
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev-prep": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 -t 5s && npm run electron:dev-prep\"",
    "start": "npm run build && npm run electron:start",
    "build:renderer": "vite build",
    "build:main": "tsc --build tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder --linux rpm"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@computing/opendesign-icons": "file:./lib/opendesign-icons-1.0.5.tgz",
    "@computing/opendesign2": "file:./lib/opendesign2-2.0.23.tgz",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^24.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "axios": "^1.10.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.6",
    "element-plus": "^2.10.2",
    "marked": "^15.0.12",
    "underscore": "^1.13.7",
    "vue": "^3.5.17",
    "vue-codemirror": "^6.1.1",
    "vue-i18n": "^11.1.6",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/underscore": "^1.13.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "mockjs": "^1.1.0",
    "sass-embedded": "^1.89.2",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^6.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-eslint2": "^5.0.4",
    "vite-plugin-mock": "^3.0.2",
    "wait-on": "^8.0.3"
  }
}
